[Unit]
Description=llm-gateway: backend-agnostic LLM lifecycle gateway
After=network.target

[Service]
Type=simple
User=test
WorkingDirectory=/home/test/sglang-manager
# The gateway stays up; the inference backend is spawned on demand by the
# gateway itself (no separate service unit needed).
ExecStart=/home/test/sglang-manager/.venv/bin/python -m llm_gateway --config /home/test/sglang-manager/config.yaml
Restart=always
RestartSec=5
# Optional: override the idle timeout from the environment (never hardcoded)
# Environment=LLM_GATEWAY_IDLE_TIMEOUT_SECONDS=1800

[Install]
WantedBy=multi-user.target
