[Unit]
Description=sglang-manager: GPU-aware SGLang lifecycle manager
After=network.target

[Service]
Type=simple
User=test
WorkingDirectory=/home/test/sglang-manager
# manager 常驻；SGLang 由 manager 按需拉起，不需要单独的 sglang.service
ExecStart=/home/test/sglang-manager/.venv/bin/python -m sglang_manager --config /home/test/sglang-manager/config.yaml
Restart=always
RestartSec=5
# 可选：用环境变量覆盖配置里的空闲超时（不硬编码）
# Environment=SGLANG_MANAGER_IDLE_TIMEOUT_SECONDS=1800

[Install]
WantedBy=multi-user.target
